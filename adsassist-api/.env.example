# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma-separated origins allowed to call the dashboard API (the pixel endpoint allows any origin)
CORS_ORIGINS=http://localhost:3000
# Run BullMQ workers + schedulers in this process (set false on API-only replicas)
RUN_WORKERS=true

# ── Database (MongoDB Atlas) ────────────────────────────────────────
# Replace with your Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adsassist?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/adsassist?retryWrites=true&w=majority

# ── Redis (BullMQ queues + rate limiting) ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth / security ─────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
# 32+ random chars. Encrypts OAuth tokens at rest (AES-256-GCM). Never change it after accounts are connected.
TOKEN_ENCRYPTION_KEY=generate-32-plus-random-chars
RATE_LIMIT_PER_MIN=120

# ── Google Ads API ──────────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional MCC (manager) id, digits only. Leave empty to auto-detect.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v24
# Must be registered as an authorized redirect URI in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# ── Meta (Facebook / Instagram) Marketing API ───────────────────────
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v24.0
# Must be added to "Valid OAuth Redirect URIs" in the Meta app (Facebook Login settings)
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/meta/callback

# ── Live sync schedule ──────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
# Each scheduled sync refreshes today + this many previous days (platforms restate recent numbers)
SYNC_LOOKBACK_DAYS=3
INITIAL_BACKFILL_DAYS=30

# ── Cloudinary (Phase 2: creative + file uploads) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (alerts + weekly digest). Leave SMTP_HOST empty to keep alerts in-app only ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AdsAssist <reports@yourdomain.com>

# ── AI summaries (Claude). Get a key at https://console.anthropic.com ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Competitor ads: optional Meta Ad Library token (defaults to the workspace's Meta connection) ──
META_AD_LIBRARY_TOKEN=
